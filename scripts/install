#!/usr/bin/env bash
# scripts/install: set up the machine it runs on for this configuration, macOS
# or Linux. Run it from the configuration (~/.config/nvim/scripts/install),
# and again any time: it adds only what's missing or too old.
#
# - Linux: everything goes in ~/.local, as you, no sudo: Neovim and the other
#   programs come from their GitHub releases. ~/.local/bin must come first on
#   your PATH (it says if it doesn't).
# - macOS: Homebrew.
#
# What it adds:
# - Needed: Neovim 0.12+, ripgrep, gh, tree-sitter (builds parsers, with a C
#   compiler).
# - Language servers, for the languages whose tools are here: ty and ruff
#   (with uv), TypeScript 7 (with npm), rust-analyzer (with rustup), and
#   lua-language-server (this configuration is Lua).
# - Then Neovim installs its plugins (at the versions in nvim-pack-lock.json)
#   and parsers.

set -euo pipefail
shopt -s inherit_errexit 2>/dev/null || true # (bash 4.4+: failures inside $(...) stop it too)

say() { printf '\033[1m%s\033[0m\n' "$*"; }
note() { printf '  %s\n' "$*"; }
has() { command -v "$1" >/dev/null 2>&1; }

# The first version number `$1 --version` prints.
version() { "$1" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1; }

# Whether command $1 is missing, or older than version $2.
missing() {
  has "$1" || return 0
  [ -n "${2:-}" ] || return 1
  [ "$(printf '%s\n%s\n' "$2" "$(version "$1")" | sort -V | head -1)" != "$2" ]
}

config=$(cd "$(dirname "$0")/.." && pwd)
bin=$HOME/.local/bin opt=$HOME/.local/opt
export PATH=$bin:$PATH

if [ "$(uname -s)" = Darwin ]; then
  has brew || { echo 'Homebrew is needed first: https://brew.sh' >&2; exit 1; }
  # get COMMAND: install the Homebrew formula that provides it.
  get() {
    local formula
    case $1 in nvim) formula=neovim ;; rg) formula=ripgrep ;; tree-sitter) formula=tree-sitter-cli ;;
      tsc) formula=typescript ;; *) formula=$1 ;; esac
    brew install "$formula" || brew upgrade "$formula"
  }
else
  case $(uname -m) in
    x86_64 | amd64) arch=x86_64 ;;
    aarch64 | arm64) arch=arm64 ;;
    *) echo "No releases to install for $(uname -m)" >&2; exit 1 ;;
  esac
  mkdir -p "$bin" "$opt"

  # The download URL of the file matching $2 in GitHub repository $1's latest release.
  latest() {
    local url
    url=$(curl -fsSL "https://api.github.com/repos/$1/releases/latest" |
      grep -oE '"browser_download_url": *"[^"]*"' | cut -d'"' -f4 | grep -E "$2" | head -1 || true)
    [ -n "$url" ] || { echo "No file matching $2 in $1's latest release" >&2; return 1; }
    echo "$url"
  }
  # Unpack the .tar.gz at URL $1 into a new temporary directory, and print its path.
  unpack() {
    local dir; dir=$(mktemp -d)
    curl -fsSL "$1" | tar -xz -C "$dir"
    echo "$dir"
  }
  # get COMMAND: install it from its latest release (or with its language's own tools).
  get() {
    local dir
    case $1 in
      nvim)
        dir=$(unpack "$(latest neovim/neovim "nvim-linux-$arch\.tar\.gz$")")
        rm -rf "$opt/nvim" && mv "$dir"/nvim-linux-* "$opt/nvim" && ln -sf "$opt/nvim/bin/nvim" "$bin/nvim" ;;
      tree-sitter)
        curl -fsSL "$(latest tree-sitter/tree-sitter "tree-sitter-linux-${arch/x86_64/x64}\.gz$")" |
          gunzip >"$bin/tree-sitter" && chmod +x "$bin/tree-sitter" ;;
      rg)
        dir=$(unpack "$(latest BurntSushi/ripgrep "ripgrep-.*-${arch/arm64/aarch64}-unknown-linux-(musl|gnu)\.tar\.gz$")")
        install -m 755 "$dir"/*/rg "$bin/rg" ;;
      gh)
        dir=$(unpack "$(latest cli/cli "gh_.*_linux_${arch/x86_64/amd64}\.tar\.gz$")")
        install -m 755 "$dir"/*/bin/gh "$bin/gh" ;;
      lua-language-server)
        dir=$(unpack "$(latest LuaLS/lua-language-server "linux-${arch/x86_64/x64}\.tar\.gz$")")
        rm -rf "$opt/lua-language-server" && mv "$dir" "$opt/lua-language-server"
        printf '#!/bin/sh\nexec "%s" "$@"\n' "$opt/lua-language-server/bin/lua-language-server" >"$bin/lua-language-server"
        chmod +x "$bin/lua-language-server" ;;
      tsc) npm install --global --prefix "$HOME/.local" typescript@7 ;;
      rust-analyzer) rustup component add rust-analyzer ;;
    esac
  }
fi

say 'Programs'
for need in 'nvim 0.12.0' 'tree-sitter 0.26.1' rg gh lua-language-server; do
  set -- $need
  if missing "$@"; then
    note "installing $1"
    get "$1"
    hash -r
  fi
done
has git || note 'git is needed'
has cc || has gcc || has clang || note 'parsers need a C compiler (Debian/Ubuntu: sudo apt install build-essential)'

say 'Language servers'
if has uv; then
  for tool in ty ruff; do
    if missing "$tool"; then note "installing $tool"; uv tool install "$tool"; fi
  done
else
  note 'Python: no uv here, so no ty or ruff (a project'\''s own .venv still works)'
fi
if has npm; then
  if missing tsc 7.0.0; then note 'installing TypeScript 7'; get tsc; fi
else
  note 'TypeScript: no npm here'
fi
if has rustup; then
  if missing rust-analyzer; then note 'installing rust-analyzer'; get rust-analyzer; fi
else
  note 'Rust: no rustup here'
fi

say 'Plugins and parsers'
# A build cut off (Neovim quit midway) leaves its lock, and later builds fail on it.
if ! pgrep -x tree-sitter >/dev/null; then
  rm -f "${XDG_CACHE_HOME:-$HOME/.cache}"/tree-sitter/lock/*.lock "$HOME"/Library/Caches/tree-sitter/lock/*.lock
fi
nvim --headless -c "lua require('nvim-treesitter').install(require('code').parsers, { summary = true }):wait(600000)" \
  -c 'qa!' 2>&1 | grep -vE ': (Downloading|Compiling parser|Installing parser|Language installed)' |
  awk '{ print "  " $0 }' || true
out=$(nvim --headless -c 'qa!' 2>&1)
[ -z "$out" ] && note 'Neovim starts cleanly' || { note 'Neovim says, on starting:'; echo "$out" | sed 's/^/    /'; }

say 'Checks'
found=$("${SHELL:-sh}" -ic 'command -v nvim' 2>/dev/null | tail -1 || true)
[ "$found" = "$(command -v nvim)" ] || note "your shell runs ${found:-no nvim}: put $bin first on PATH"
gh auth status >/dev/null 2>&1 || note 'GitHub: run gh auth login'
if [ "$(uname -s)" = Linux ] && ! has inotifywait; then
  note 'For diff views that follow every change as it happens: sudo apt install inotify-tools'
  note '  (without it, they catch up when you come back to them)'
fi
say "Done: $config"
